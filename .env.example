# ─────────────────────────────────────────────
#  SAS – Student Attendance System
#  Environment Variable Template
#  Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sas_db

# ── JWT ──────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_secret
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Pinecone ─────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=sas-face-embeddings
PINECONE_NAMESPACE=college_students
# Pinecone environment / region (e.g. us-east-1)
PINECONE_ENVIRONMENT=us-east-1

# ── AI Models ────────────────────────────────
# InsightFace model pack (buffalo_l recommended for production)
INSIGHTFACE_MODEL=buffalo_l
AI_MODEL_DIR=./ai_models

# Anti-spoofing model weights path
ANTISPOOF_MODEL_PATH=./ai/anti_spoofing/weights

# ── Recognition Thresholds ───────────────────
# Cosine similarity threshold (0.0–1.0) above which a match is accepted
FACE_MATCH_THRESHOLD=0.45

# ── Attendance Thresholds ────────────────────
LOW_ATTENDANCE_THRESHOLD=50
HIGH_ATTENDANCE_THRESHOLD=90

# ── Server ───────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App Mode ─────────────────────────────────
# "production" | "development"
APP_MODE=development

# ── Seed / Demo ──────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@SAS2024
SEED_ADMIN_EMAIL=admin@sas.edu
